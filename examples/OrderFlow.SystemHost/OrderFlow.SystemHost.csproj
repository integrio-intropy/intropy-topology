<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.1" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>OrderFlow.SystemHost</RootNamespace>
        <IsAspireHost>true</IsAspireHost>
        <IsPackable>false</IsPackable>
        <!-- The host intentionally runs without the Aspire CLI bundle; the warning
             would otherwise land on stdout ahead of `graph` JSON output. -->
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
        <UserSecretsId>order-flow-systemhost</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Intropy.Topology.Aspire/Intropy.Topology.Aspire.csproj" IsAspireProjectResource="false" />
        <ProjectReference Include="../../src/Intropy.Topology.Generation/Intropy.Topology.Generation.csproj" IsAspireProjectResource="false" />
        <ProjectReference Include="../OrderFlow.Contracts/OrderFlow.Contracts.csproj" IsAspireProjectResource="false" />
    </ItemGroup>

</Project>
