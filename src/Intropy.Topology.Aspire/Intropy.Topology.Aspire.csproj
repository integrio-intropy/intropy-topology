<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>.NET Aspire run-backend for Intropy.Topology. Discovers a system's validated topology, generates its Dapr components, and translates the model into Aspire resources (projects, RabbitMQ, Dapr sidecars) that DCP orchestrates for local F5.</Description>
    <PackageTags>intropy;topology;aspire;dapr;integration</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Intropy.Topology\Intropy.Topology.csproj" />
    <ProjectReference Include="..\Intropy.Topology.Generation\Intropy.Topology.Generation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Dapr" />
  </ItemGroup>

</Project>
